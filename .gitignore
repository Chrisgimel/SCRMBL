# ============================================================
# SCRMBL — files git should NEVER track
# Anything listed here stays on your disk but is invisible to git.
# ============================================================

# --- SECRETS (most important section) -----------------------
# Never commit these. If you ever add real API keys, put them
# in a .env file and they are automatically excluded.
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
secrets.json
credentials.json

# --- Local databases (contain real user data) ---------------
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- Dependencies (huge, rebuildable with `npm install`) ----
node_modules/
.pnp
.pnp.js

# --- Build output (regenerated by `npm run build`) ----------
build/
dist/
coverage/

# --- Old snapshot folders (git replaces these) --------------
# ~900 MB of manual backups. Kept on disk, not in git history.
_Archive/
_Obsolete/

# --- Blender working/auto-backup files ----------------------
*.blend1
*.blend2

# --- Native mobile build artifacts --------------------------
scrmbl-app/android/app/build/
scrmbl-app/android/.gradle/
scrmbl-app/android/local.properties
scrmbl-app/ios/App/Pods/
scrmbl-app/ios/App/build/
scrmbl-app/android/app/src/main/assets/public/
scrmbl-app/ios/App/App/public/

# --- Logs -----------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editor / OS junk ---------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Claude Code local settings -----------------------------
.claude/settings.local.json
.claude/jobs/
.claude/*.lock
